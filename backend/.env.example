# Database selection: sqlite or mysql
DB_TYPE=sqlite
SQLITE_DB_PATH=./volunteer.db

# Server port
PORT=3000

# Optional MySQL configuration (only required if DB_TYPE=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=volunteer_app
DB_PASSWORD=volunteer123
DB_NAME=volunteer_db

# Session Secret (min 32 characters recommended for production)
AUTH_TOKEN_SECRET=replace_with_a_secure_random_secret_in_production
